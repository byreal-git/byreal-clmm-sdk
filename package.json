{
  "name": "@byreal-io/byreal-clmm-sdk",
  "version": "0.2.1",
  "description": "Byreal CLMM SDK for Solana",
  "type": "module",
  "license": "MIT",
  "author": "Byreal Team (https://github.com/byreal-git)",
  "homepage": "https://github.com/byreal-git/byreal-clmm-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/byreal-git/byreal-clmm-sdk.git"
  },
  "keywords": [
    "solana",
    "clmm",
    "concentrated-liquidity",
    "defi",
    "dex",
    "amm",
    "sdk"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "postversion": "git push && git push --tags",
    "test": "vitest"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@noble/hashes": "1.8.0",
    "@solana/buffer-layout": "4.0.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "decimal.js": "10.5.0",
    "lodash-es": "4.17.21"
  },
  "devDependencies": {
    "dotenv": "16.5.0",
    "typescript": "5.7.3",
    "vitest": "3.2.3"
  }
}
